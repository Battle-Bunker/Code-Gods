# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local

# These are production dependencies, even though generated environments/output
# are ignored by Git. Keep the external workspace runtime and its pnpm links,
# frozen Python environment, and API build output in the deployment image.
!.pythonlibs
!.pythonlibs/**
!lib/game-runtime
!lib/game-runtime/**
!node_modules
!node_modules/**
!artifacts/api-server/node_modules
!artifacts/api-server/node_modules/**
!artifacts/api-server/dist
!artifacts/api-server/dist/**
