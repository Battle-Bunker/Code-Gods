{
  "name": "@workspace/game-utilities",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./calibration-data": "./src/calibration-data.ts",
    "./estimator": "./scripts/estimator.ts",
    "./canonical-json": "./src/canonical-json.ts",
    "./hold": "./scripts/hold.ts"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --build",
    "calibrate": "node --experimental-strip-types scripts/calibrate.ts",
    "difficulty": "node --experimental-strip-types scripts/rule-difficulty.ts",
    "layered": "node --experimental-strip-types scripts/layered-profile.ts",
    "mutation-cost": "node --experimental-strip-types scripts/mutation-cost.ts",
    "coordination": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/coordination.ts"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "@types/node": "catalog:"
  },
  "dependencies": {
    "@workspace/game-types": "workspace:*"
  }
}
