modules = ["nodejs-24", "python-base-3.13"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Player"

[[workflows.workflow]]
name = "Player"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=22772 BASE_PATH=/ pnpm --filter @workspace/player-web run dev"
waitForPort = 22772

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
