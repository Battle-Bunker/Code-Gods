{
  "name": "@workspace/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:game": "node --experimental-transform-types --disable-warning=ExperimentalWarning --test --test-concurrency=1 test/game*.test.ts",
    "bench": "node scripts/bench.mjs",
    "test:auth": "node scripts/test-auth.mjs",
    "gen-jwt-key": "node scripts/gen-jwt-key.mjs",
    "deploy-static": "node scripts/deploy-static.mjs",
    "fake-oidc": "node scripts/fake-oidc.mjs",
    "upload-runtime": "node scripts/upload-runtime.mjs",
    "assistant:live": "node scripts/assistant-provider.mjs live",
    "assistant:mock": "node scripts/assistant-provider.mjs mock",
    "assistant:status": "node scripts/assistant-provider.mjs status",
    "test:assistant-live": "node --experimental-transform-types --disable-warning=ExperimentalWarning --test --test-concurrency=1 test/assistant-live.test.ts",
    "upload-calibration": "node scripts/upload-calibration.mjs",
    "test:mcp": "node --experimental-transform-types --disable-warning=ExperimentalWarning --test --test-concurrency=1 test/mcp.test.ts",
    "test:unit": "node --experimental-transform-types --disable-warning=ExperimentalWarning --test test/unit/*.test.ts"
  },
  "dependencies": {
    "@convex-dev/better-auth": "0.12.6",
    "@convex-dev/static-hosting": "0.2.1",
    "@modelcontextprotocol/server": "2.4.0",
    "@workspace/ai-player": "workspace:*",
    "@workspace/game-core": "workspace:*",
    "@workspace/game-runtime": "workspace:*",
    "@workspace/game-types": "workspace:*",
    "@workspace/game-utilities": "workspace:*",
    "@workspace/player-client": "workspace:*",
    "better-auth": "1.6.33",
    "convex": "1.48.0",
    "jose": "6.2.13",
    "quickjs-emscripten": "0.31.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "catalog:"
  }
}
