modules = ["nodejs-24"]

[workflows]
runButton = "Player"

[[workflows.workflow]]
name = "Player"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=22772 BASE_PATH=/ pnpm --filter @workspace/player-web run dev"
waitForPort = 22772

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[nix]
channel = "stable-25_05"
