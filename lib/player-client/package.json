{
  "name": "@workspace/player-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./engine": "./src/engine.ts",
    "./assistant": "./src/assistant.ts",
    "./state": "./src/state.ts",
    "./connect": "./src/connect.ts",
    "./tools": "./src/tools.ts",
    "./rules": "./src/rules.ts",
    "./catalog": "./src/catalog.ts",
    "./lenses": "./src/lenses.ts",
    "./layout": "./src/layout.ts"
  },
  "scripts": {
    "cli": "node --disable-warning=ExperimentalWarning --experimental-transform-types src/cli.ts",
    "assistant": "node --disable-warning=ExperimentalWarning --experimental-transform-types src/cli.ts assistant",
    "test": "node scripts/test.mjs",
    "gen:tools": "node --disable-warning=ExperimentalWarning --experimental-transform-types scripts/gen-tools.ts",
    "gen:catalog": "node --disable-warning=ExperimentalWarning --experimental-transform-types scripts/gen-catalog-doc.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "@workspace/engine": "workspace:*",
    "@workspace/game-core": "workspace:*",
    "convex": "1.48.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}
